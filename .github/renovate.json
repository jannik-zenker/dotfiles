{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",

  "nix": {
    "enabled": true
  },

  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am every day"]
  },

  "packageRules": [
    {
      "enabledManagers": ["nix"],
      "matchManagers": ["nix"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "rebase"
    }
  ]
}
